// Resource script. Language tables are embedded as RCDATA so the executable
#pragma code_page(65001)
// stays a single self-contained file.
#include <winver.h>

#define IDR_LANG_MAP     100
#define IDR_LANG_EN      101
#define IDR_LANG_ZH_HANS 102
#define IDR_LANG_ZH_HANT 103
#define IDR_LANG_JA      104
#define IDR_LANG_DE      105
#define IDR_LANG_FR      106
#define IDR_LANG_ES      107
#define IDR_LANG_RU      108
#define IDR_LANG_KO      109
#define IDR_LANG_PTBR    110
#define IDR_LANG_IT      111

1 ICON "app.ico"

IDR_LANG_MAP     RCDATA "lang\\map.txt"
IDR_LANG_EN      RCDATA "lang\\en.lang"
IDR_LANG_ZH_HANS RCDATA "lang\\zh-Hans.lang"
IDR_LANG_ZH_HANT RCDATA "lang\\zh-Hant.lang"
IDR_LANG_JA      RCDATA "lang\\ja.lang"
IDR_LANG_DE      RCDATA "lang\\de.lang"
IDR_LANG_FR      RCDATA "lang\\fr.lang"
IDR_LANG_ES      RCDATA "lang\\es.lang"
IDR_LANG_RU      RCDATA "lang\\ru.lang"
IDR_LANG_KO      RCDATA "lang\\ko.lang"
IDR_LANG_PTBR    RCDATA "lang\\pt-BR.lang"
IDR_LANG_IT      RCDATA "lang\\it.lang"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "王云正"
      VALUE "FileDescription",  "我不需要卸载图标"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "NoUninstallIcon"
      VALUE "OriginalFilename", "NoUninstallIcon.exe"
      VALUE "ProductName",      "我不需要卸载图标"
      VALUE "ProductVersion",   "1.0.0.0"
      VALUE "LegalCopyright",   "MIT License, 王云正"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
